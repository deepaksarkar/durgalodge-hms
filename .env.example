# ==============================================================================
# DURGA LODGE HMS — Environment Variables Template (.env.example)
# ==============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env:
#    cp .env.example .env
# 2. Fill in production credentials. Never commit your actual .env file to Git!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database Configuration (PostgreSQL 15+)
# ------------------------------------------------------------------------------
# Local Docker development format:
# DATABASE_URL="postgresql://admin:YOUR_DEV_PASSWORD@localhost:5432/durga_lodge?schema=public&sslmode=disable"
#
# Production hosted PostgreSQL format (Neon, Supabase, AWS RDS, Render, etc.):
# DATABASE_URL="postgresql://db_user:db_password@db_host.provider.com:5432/durga_lodge?schema=public&sslmode=require"
DATABASE_URL="postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:5432/<DB_NAME>?schema=public&sslmode=require"

# Local Docker container credentials (only needed if running postgres via docker-compose)
POSTGRES_USER=admin
POSTGRES_PASSWORD=<CHANGE_THIS_TO_A_STRONG_PASSWORD>
POSTGRES_DB=durga_lodge

# ------------------------------------------------------------------------------
# 2. Authentication & Session Security
# ------------------------------------------------------------------------------
# High-entropy cryptographic secret for signing session JWTs (minimum 32 characters).
# Generate using terminal command: openssl rand -base64 32
AUTH_SECRET="<GENERATE_RANDOM_32_CHAR_SECRET_USING_OPENSSL>"

# Base URL of the deployed application (used for redirects and links)
APP_URL="https://your-domain.com"

# Node environment (production / development)
NODE_ENV="production"

# ------------------------------------------------------------------------------
# 3. Hotel Regional Configuration
# ------------------------------------------------------------------------------
# Standard IANA Timezone for hotel operations and billing cutoffs
HOTEL_TIMEZONE="Asia/Kolkata"

# Currency code (Durga Lodge uses Indian Rupee)
CURRENCY="INR"

# ------------------------------------------------------------------------------
# 4. Expense Receipt Storage
# ------------------------------------------------------------------------------
# Local filesystem storage path (ensure directory has write permissions)
STORAGE_PROVIDER="local"
STORAGE_PATH="./public/uploads/receipts"

# ------------------------------------------------------------------------------
# 5. Optional Secure Tunnel (Cloudflare Tunnel)
# ------------------------------------------------------------------------------
# Leave empty unless running docker-compose with cloudflared tunnel profile
CLOUDFLARE_TUNNEL_TOKEN=""